# Copy to .env and fill in. Validated at startup by src/config/env.ts.

NODE_ENV=local
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/wedding_rsvp?schema=public

# Frontend origin, no trailing slash. Used as the CORS origin and as the base for
# links in verification/reset emails and WhatsApp RSVP messages.
# Production: https://ai-wedding-rsvp-generator.pages.dev
WEB_APP_URL=http://localhost:5173

JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# S3 (uploads, generated images)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_BUCKET_PUT_URL_EXPIRE=300
AWS_BUCKET_GET_URL_EXPIRE=3600

# SES (verification and password reset emails)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
AWS_SENDER_EMAIL=
PROJECT_NAME=AI Wedding RSVP

# Gemini (AI invite cards)
GEMINI_API_KEY=

# Redis (job queues, rate limits, live RSVP updates)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Country code added to guest numbers saved without one (WhatsApp links)
WHATSAPP_DEFAULT_COUNTRY_CODE=91
